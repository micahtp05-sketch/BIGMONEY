# Claude API — used for image -> item identification.
# Leave unset to run with ANTHROPIC_API_KEY from an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Price source selection: "fixture" (offline, default) or "ebay"
PRICE_SOURCE=fixture

# eBay Browse API (only needed when PRICE_SOURCE=ebay)
# Obtain from https://developer.ebay.com/ -> your app -> OAuth client credentials
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# "PRODUCTION" or "SANDBOX"
EBAY_ENV=PRODUCTION
# Marketplace to search, e.g. EBAY_US, EBAY_GB, EBAY_DE
EBAY_MARKETPLACE=EBAY_US

PORT=3000

# Commons — where community state is written. ":memory:" runs without a file.
COMMUNITY_DATA=
# New accounts allowed per hour from one IP address.
COMMUNITY_SIGNUPS_PER_HOUR=5
# Handles that are moderators from the start, comma separated. Somebody has to
# be able to rule on the first report.
COMMUNITY_MODERATORS=

# --- Sending one-time codes ---------------------------------------------
# Without these, codes are only logged to the console, and the server refuses
# to start with NODE_ENV=production. Nobody can confirm an address or a number
# until at least one of these is set.

# resend | postmark | sendgrid
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Must be an address the provider has verified for your domain.
EMAIL_FROM=Commons <hello@example.org>

# twilio | messagebird
SMS_PROVIDER=
SMS_API_KEY=
# Twilio: a number you own. MessageBird: a number or a sender ID.
SMS_FROM=
# Twilio only — the account SID. SMS_API_KEY is then the auth token.
SMS_ACCOUNT_ID=
