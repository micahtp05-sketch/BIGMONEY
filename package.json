{
  "name": "commons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Commons: rooms where people talk to each other and to the identity-checked professionals among them. A photo-to-price estimator lives alongside it.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/browser/run.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "test:browser": "node test/browser/commons.ui.mjs",
    "test:pwa": "node test/browser/pwa.mjs",
    "test:cinematic": "node test/browser/cinematic.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "electron desktop/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2"
  }
}
